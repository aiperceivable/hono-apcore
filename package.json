{
  "name": "hono-apcore",
  "version": "0.3.1",
  "description": "Hono adapter for the apcore AI-Perceivable module ecosystem",
  "type": "module",
  "packageManager": "pnpm@10.13.1",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ],
    "ignoredBuiltDependencies": [
      "keytar"
    ]
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": {
        "browser": "./dist/edge.d.ts",
        "default": "./dist/index.d.ts"
      },
      "browser": "./dist/edge.js",
      "worker": "./dist/edge.js",
      "workerd": "./dist/edge.js",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./edge": {
      "types": "./dist/edge.d.ts",
      "import": "./dist/edge.js"
    },
    "./mcp": {
      "types": "./dist/mcp/index.d.ts",
      "import": "./dist/mcp/index.js"
    },
    "./cli": {
      "types": "./dist/cli/index.d.ts",
      "import": "./dist/cli/index.js"
    },
    "./a2a": {
      "types": "./dist/a2a/index.d.ts",
      "import": "./dist/a2a/index.js"
    }
  },
  "bin": {
    "hono-apcore": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "check:edge": "node scripts/check-edge-bundle.mjs",
    "lint": "eslint src/ tests/",
    "clean": "rm -rf dist"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "peerDependencies": {
    "@hono/node-server": ">=1.13.0",
    "apcore-a2a": ">=0.8.5",
    "apcore-cli": ">=0.12.7",
    "apcore-mcp": ">=0.23.5",
    "hono": ">=4.0.0",
    "zod": ">=3.23.0"
  },
  "peerDependenciesMeta": {
    "@hono/node-server": {
      "optional": true
    },
    "apcore-a2a": {
      "optional": true
    },
    "apcore-cli": {
      "optional": true
    },
    "apcore-mcp": {
      "optional": true
    },
    "zod": {
      "optional": true
    }
  },
  "dependencies": {
    "apcore-js": ">=0.32.3",
    "apcore-toolkit": ">=0.14.1",
    "js-yaml": "^4.1.0"
  },
  "devDependencies": {
    "@hono/node-server": "^2.1.1",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@sinclair/typebox": "^0.34.52",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^20.19.0",
    "@vitest/coverage-v8": "^3.2.0",
    "apcore-a2a": "^0.8.5",
    "apcore-cli": "^0.12.7",
    "apcore-mcp": "^0.23.5",
    "apdev-js": "^0.2.0",
    "esbuild": "^0.28.2",
    "hono": "^4.13.4",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0",
    "zod": "^4.4.3"
  },
  "keywords": [
    "hono",
    "apcore",
    "mcp",
    "model-context-protocol",
    "a2a",
    "ai",
    "ai-tools",
    "llm",
    "openai",
    "tool-calling",
    "edge",
    "typescript"
  ],
  "author": "aiperceivable",
  "homepage": "https://github.com/aiperceivable/hono-apcore#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/aiperceivable/hono-apcore.git"
  },
  "bugs": {
    "url": "https://github.com/aiperceivable/hono-apcore/issues"
  },
  "license": "Apache-2.0",
  "apdev": {
    "base_package": "hono-apcore"
  }
}
